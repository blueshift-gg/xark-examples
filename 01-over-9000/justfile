# over-9000: circuit → dev keys → verifier crate → TS client → program.
# Prerequisites: ../RUNBOOK.md. The root `just test` runs client/ against the program.

set shell := ["bash", "-euo", "pipefail", "-c"]

build:
    @xark --version | grep -q '^xark 0\.3\.' || { echo "needs xark 0.3: see ../RUNBOOK.md" >&2; exit 1; }
    xark build circuit
    # DEV keys from local randomness: never deploy them (see ../RUNBOOK.md).
    xark setup circuit --insecure-dev-mode --r1cs-form reduced
    # The verifier crate's self-test vector: a proof of 9001.
    xark prove circuit --inputs '{"power_level": 9001}'
    xark export circuit --allow-insecure --crate-name over-9000-xark-verifier
    xark client circuit --out client/
    cd program && cargo build-sbf --arch v3

# The circuit's own tests: 9001 passes, 9000 doesn't.
test-circuit:
    xark test circuit

# Build, then prove with the client and verify on-chain (LiteSVM). `npm install` first.
test: build
    npm test

clean:
    rm -rf circuit/target program/target
