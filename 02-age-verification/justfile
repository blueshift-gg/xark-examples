# age-verification — the xark pipeline. See ../RUNBOOK.md for prerequisites.

set shell := ["bash", "-uc"]

# The demo inputs. `commitment` is Poseidon2(birth_year, nonce) — recompute it
# with `just commit` if you change either private value.
birth_year := "1990"
nonce := "13102783505849749806854498441424493672889223651541975554449217606361432761234"
commitment := "16270599866198939632822375879477475677301143667419388581635073777919968987292"
current_year := "2026"

# Compute the Poseidon2 commitment for a birth_year/nonce (native mirror of the
# circuit's gadget hash, KAT-pinned — params always match).
commit:
    cd ../e2e && cargo run -q --locked --bin commit -- {{birth_year}} {{nonce}}
    @echo "→ paste the printed field element into this justfile as commitment"

# Compile → keys (DEV MODE) → prove → verify.
prove:
    xark build circuit
    xark inspect circuit
    xark setup circuit
    @tmp=$(mktemp); trap 'rm -f "$tmp"' EXIT; printf '%s\n' \
        'identity.birth_year = {{birth_year}}' 'identity.nonce = {{nonce}}' \
        'commitment = {{commitment}}' 'current_year = {{current_year}}' \
        > "$tmp"; xark prove circuit --inputs "$tmp"

# Run the in-crate circuit tests (adult passes / minor fails / wrong opening).
test-circuit:
    xark test circuit

# Generate the on-chain verifier crate (VK embedded).
export: prove
    xark export circuit --allow-insecure --crate-name age-verification-xark-verifier
    @echo "→ verifier crate + instruction_data.bin at circuit/target/xark/age_verification/verifier/"

# Build the Solana program (needs cargo-build-sbf).
build-program: export
    cd program && cargo build-sbf

clean:
    rm -rf circuit/target program/target
