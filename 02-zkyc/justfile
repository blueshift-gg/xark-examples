# zkyc: circuit → keys → verifier crate → TS client → program.
# Prerequisites: ../RUNBOOK.md. The root `just test` runs client/ against the program.

set shell := ["bash", "-euo", "pipefail", "-c"]

build:
    @xark --version | grep -q '^xark 0\.3\.' || { echo "needs xark 0.3: see ../RUNBOOK.md" >&2; exit 1; }
    xark build circuit
    # A single-party key from this machine's randomness (see ../RUNBOOK.md).
    xark setup circuit --r1cs-form reduced
    # The verifier crate's self-test vector: a proof of examples/demo.rs.
    cd circuit && cargo run -q --release --example demo
    xark export circuit --crate-name zkyc-xark-verifier
    xark client circuit --out client/
    cd program && cargo build-sbf --arch v3

# The circuit's own tests (who passes, who doesn't), then the program's: its policy
# is the circuit's, packed as the circuit packs it, and the demo proof verifies
# against what it assembles. The program's need `build` first (the verifier crate).
test-circuit:
    xark test circuit
    cd program && cargo test -q --release

# Build, then every test: the circuit's, the program's, and the client's, which
# proves with the client and verifies onchain (LiteSVM). `npm install` first.
test: build test-circuit
    npm test

clean:
    rm -rf circuit/target program/target
