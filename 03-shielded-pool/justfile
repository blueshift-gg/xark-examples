# shielded-pool — two circuits (deposit, withdraw) + one Anchor program.
# Fill each circuit's Prover.toml first (see ../RUNBOOK.md for how inputs are
# generated; the e2e test uses a worked example). Then:

set shell := ["bash", "-uc"]

# Prove + export the DEPOSIT circuit.
prove-deposit:
    cd circuits/deposit && nargo execute
    cd circuits/deposit && xark inspect       # confirm public-input order
    cd circuits/deposit && xark setup --insecure-dev-mode
    cd circuits/deposit && xark prove
    cd circuits/deposit && xark verify
    cd circuits/deposit && xark export --crate-name shielded-pool-deposit-xark-verifier

# Prove + export the WITHDRAW circuit.
prove-withdraw:
    cd circuits/withdraw && nargo execute
    cd circuits/withdraw && xark inspect
    cd circuits/withdraw && xark setup --insecure-dev-mode
    cd circuits/withdraw && xark prove
    cd circuits/withdraw && xark verify
    cd circuits/withdraw && xark export --crate-name shielded-pool-withdraw-xark-verifier

# Build the Anchor program (run prove-deposit AND prove-withdraw first — they
# generate the two verifier crates the program depends on).
build-program:
    cd program && cargo build-sbf

clean:
    rm -rf circuits/deposit/target circuits/withdraw/target program/target program/.anchor
