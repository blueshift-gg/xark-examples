# shielded-pool: two circuits (deposit, withdraw) → dev keys → verifier crates →
# TS clients → one Anchor program. Prerequisites: ../RUNBOOK.md. The root
# `just test` runs client/ against the program.

set shell := ["bash", "-euo", "pipefail", "-c"]

build: xark (circuit "deposit" "shielded-pool-deposit-xark-verifier") (circuit "withdraw" "shielded-pool-withdraw-xark-verifier")
    cd program && cargo build-sbf --arch v3

# One circuit: build, DEV keys (never deploy them, see ../RUNBOOK.md), a proof of
# its demo inputs as the verifier crate's self-test, the verifier crate, the client.
circuit name crate:
    xark build circuits/{{name}}
    xark setup circuits/{{name}} --insecure-dev-mode --r1cs-form reduced
    cd circuits/{{name}} && cargo run -q --release --example demo
    xark export circuits/{{name}} --allow-insecure --crate-name {{crate}}
    xark client circuits/{{name}} --out client/

# The circuits' own tests, and the tree's.
test-circuit:
    cd circuits/pool && cargo test --release
    xark test circuits/deposit
    xark test circuits/withdraw

xark:
    @xark --version | grep -q '^xark 0\.3\.' || { echo "needs xark 0.3: see ../RUNBOOK.md" >&2; exit 1; }

# Build, then prove with the client and verify on-chain (LiteSVM). `npm install` first.
test: build
    npm test

clean:
    rm -rf circuits/*/target program/target program/.anchor
