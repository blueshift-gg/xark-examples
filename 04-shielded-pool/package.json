{
  "name": "shielded-pool",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "xark build",
    "check": "xark build --check",
    "test:all": "xark test",
    "test": "tsc --noEmit && vitest run",
    "fmt:check": "cargo fmt --all --check",
    "clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "clean": "xark clean && cargo clean"
  },
  "devDependencies": {
    "@blueshift-gg/xark": "^0.4.0",
    "@solana/kit": "^8.5.0",
    "@types/node": "^22.0.0",
    "litesvm": "^1.6.1",
    "typescript": "^5.6.0",
    "vitest": "^5.1.0"
  }
}
