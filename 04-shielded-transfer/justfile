# shielded-transfer (04) — one transact circuit + one Anchor/SPL program.
# Witnesses come from ../e2e's `transfer-witness` (native replay of the demo
# chain, same Poseidon2 as the circuit). See ../RUNBOOK.md. Full flow: `just all`.

set shell := ["bash", "-uc"]

vd := "circuits/transact/target/xark/shielded_transact"

# One-time: compile the circuit + trusted setup (DEV keys — never for production).
setup:
    xark build circuits/transact
    xark inspect circuits/transact        # confirm 18 public inputs
    xark setup circuits/transact

# Generate the deposit -> transfer -> withdraw proof chain (needs `setup` first).
# Each tx: write a private input file, prove, then stash the LE byte forms,
# stash them under chain/. All three share one proving key (= one embedded VK).
gen-chain:
    mkdir -p circuits/transact/chain
    tmp=$(mktemp); trap 'rm -f "$tmp"' EXIT; \
    for tx in dep xfer wd; do \
        (cd ../e2e && cargo run -q --bin transfer-witness -- $tx) > "$tmp"; \
        xark prove circuits/transact --input-file "$tmp"; \
        xark export circuits/transact --allow-insecure --crate-name shielded-transfer-transact-xark-verifier --verifier-dep '{ git = "https://github.com/blueshift-gg/xark", rev = "44f9a8d3b1f5af90a57249fa1dad308968922a03" }'; \
        cp {{vd}}/verifier/proof.solana.bin circuits/transact/chain/${tx}_proof.bin; \
        cp {{vd}}/verifier/public_inputs.solana.bin circuits/transact/chain/${tx}_pi.bin; \
    done

# Build the Anchor program (needs `gen-chain` first — it generates the verifier crate).
build-program:
    cd program && cargo build-sbf

# Everything, then the in-VM e2e (deposit -> private transfer -> withdraw).
all: setup gen-chain build-program
    cd ../e2e && cargo test --test transfer

clean:
    rm -rf circuits/transact/target circuits/transact/chain program/target program/.anchor
