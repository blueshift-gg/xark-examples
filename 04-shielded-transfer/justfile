# shielded-transfer: the transact circuit → keys → verifier crate → TS client
# → one Pinocchio + SPL program. Prerequisites: ../RUNBOOK.md. The root `just test`
# runs client/ against the program.

set shell := ["bash", "-euo", "pipefail", "-c"]

build:
    @xark --version | grep -q '^xark 0\.3\.' || { echo "needs xark 0.3: see ../RUNBOOK.md" >&2; exit 1; }
    xark build circuits/transact
    # A single-party key from this machine's randomness (see ../RUNBOOK.md).
    xark setup circuits/transact --r1cs-form reduced
    # The verifier crate's self-test vector: a proof of examples/demo.rs.
    cd circuits/transact && cargo run -q --release --example demo
    xark export circuits/transact --crate-name shielded-transfer-transact-xark-verifier
    xark client circuits/transact --out client/
    cd program && cargo build-sbf --arch v3

# The circuit's own tests (deposit, pay privately, and what's refused), then the
# program's: each account check refuses on fake accounts, and the demo proof
# verifies against the public inputs it assembles. The program's need `build`
# first (the verifier crate).
test-circuit:
    xark test circuits/transact
    cd program && cargo test -q --release

# Build, then every test: the circuit's, the program's, and the client's, which
# proves with the client and transacts onchain (LiteSVM). `npm install` first.
test: build test-circuit
    npm test

clean:
    rm -rf circuits/transact/target program/target
