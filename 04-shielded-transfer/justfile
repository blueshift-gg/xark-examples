# shielded-transfer: the transact circuit → dev keys → verifier crate → TS client
# → one Anchor + SPL program. Prerequisites: ../RUNBOOK.md. The root `just test`
# runs client/ against the program.

set shell := ["bash", "-euo", "pipefail", "-c"]

build:
    @xark --version | grep -q '^xark 0\.3\.' || { echo "needs xark 0.3: see ../RUNBOOK.md" >&2; exit 1; }
    xark build circuits/transact
    # DEV keys from local randomness: never deploy them (see ../RUNBOOK.md).
    xark setup circuits/transact --insecure-dev-mode --r1cs-form reduced
    # The verifier crate's self-test vector: a proof of examples/demo.rs.
    cd circuits/transact && cargo run -q --release --example demo
    xark export circuits/transact --allow-insecure --crate-name shielded-transfer-transact-xark-verifier
    xark client circuits/transact --out client/
    cd program && cargo build-sbf --arch v3

# The circuit's own tests: deposit, pay privately, and what's refused.
test-circuit:
    xark test circuits/transact

# Build, then prove with the client and verify on-chain (LiteSVM). `npm install` first.
test: build
    npm test

clean:
    rm -rf circuits/transact/target program/target program/.anchor
